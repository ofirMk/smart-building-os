# ── AI Worker Environment Variables ──────────────────────────
# העתק קובץ זה ל-.env ומלא את הערכים
# cp env.example .env

# Bearer token לאימות בקשות מ-Supabase pg_net ל-Worker
# צור עם: openssl rand -hex 32
AI_WORKER_BEARER=replace_me_with_random_hex

# HMAC secret לאימות callback מ-Worker ל-ERP
# חייב להיות זהה ל-AI_WORKER_SECRET ב-.env.local של ה-Next.js ERP
# צור עם: openssl rand -hex 32
AI_WORKER_SECRET=replace_me_with_same_secret_as_erp

# כתובת בסיס של ה-ERP (ללא trailing slash)
# מקומית: http://localhost:3000
# Production: https://your-app.vercel.app
ERP_BASE_URL=http://localhost:3000

# רמת לוג (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
