# ── AI Worker Environment Variables ──────────────────────────
# העתק קובץ זה ל-.env ומלא את הערכים
# cp env.example .env

# Bearer token לאימות בקשות מ-Supabase pg_net ל-Worker
# צור עם: openssl rand -hex 32
# חייב להיות זהה ל-AI_WORKER_BEARER ב-.env.local של ה-Next.js ERP
AI_WORKER_BEARER=replace_me_with_random_hex

# HMAC secret לאימות callback מ-Worker ל-ERP
# חייב להיות זהה ל-AI_WORKER_SECRET ב-.env.local של ה-Next.js ERP
# צור עם: openssl rand -hex 32
AI_WORKER_SECRET=replace_me_with_same_secret_as_erp

# כתובת בסיס של ה-ERP (ללא trailing slash)
# מקומית: http://localhost:3000
# Production: https://your-app.vercel.app
ERP_BASE_URL=http://localhost:3000

# Supabase project URL (זהה ל-NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service-role key — מאפשר גישת כתיבה מלאה, שמור בסוד
# אל תחשיפו בלוגים או בקוד!
SUPABASE_SERVICE_ROLE_KEY=replace_me_with_service_role_key

# Direct PostgreSQL DSN לחיבור asyncpg (IoT correlator / LISTEN channel)
# מקומית: postgresql://postgres:postgres@localhost:5432/postgres
# Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_DSN=postgresql://postgres:replace_me@localhost:5432/postgres

# Redis connection URL (IoT sliding-window buffer)
# מקומית: redis://localhost:6379/0
# Production: rediss://:password@your-redis-host:6380/0
REDIS_URL=redis://localhost:6379/0

# Gemini LLM (CrewAI) — Google AI Studio
GEMINI_API_KEY=replace_me_with_gemini_key
GEMINI_MODEL=gemini-2.5-flash

# Sentinel UUID — the Supabase Auth user ID used as created_by for system Work Orders
# צרו משתמש שירות ב-Supabase Auth → Authentication → Users → Add user
# חייב להיות זהה ל-AI_WORKER_SYSTEM_USER_ID ב-.env.local של ה-Next.js ERP
AI_WORKER_SYSTEM_USER_ID=replace_me_with_service_account_uuid

# רמת לוג (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
