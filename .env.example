NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# העתק ל-.env.local ומלא ערכים. לפרודקשן השתמשו בסודות מוצפנים בפלטפורמת האחסון.

# --- חובה ללקוח + שרת (אימות Supabase) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- שרת בלבד (אל תחשיפו לדפדפן) ---
# SUPABASE_SERVICE_ROLE_KEY=   # רק ל-route/API שדורשים הרשאת שירות
# CRON_SECRET=                 # /api/cron — אימות קריאות מתוזמנות

# --- AI (לפי מודולים) ---
# GEMINI_API_KEY=              # קליטת מכרז, OCR חשבוניות — Google Generative AI
# AI_GATEWAY_API_KEY=your_api_key_here   # Cursor AI Gateway — הכנס כאן את מפתח ה-API (העתק ל-.env.local והסר #)

# --- אחסון מסמכי מכרז (Supabase Storage) ---
# ברירת מחדל בקוד: tender_documents. אם נשארתם על הדלי legacy:
# NEXT_PUBLIC_TENDER_DOCUMENTS_BUCKET=tender-documents
# TENDER_DOCUMENTS_STORAGE_BUCKET=tender-documents

# --- אופציונלי / דמו / צ'אט / דיירים (ברירות מחדל בקוד אם ריק) ---
# DEMO_TICKET_CREATOR_PROFILE_ID=
# CHAT_DEFAULT_BUILDING_ID=
# TENANT_DEFAULT_BUILDING_ID=
# DEMO_TENANT_PROFILE_ID=

# --- דוחות מערכת / תמיכה (Resend או Postmark) ---
# SYSTEM_SUPPORT_EMAIL=support@yourbrand.co.il
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Diamond System <notifications@yourbrand.co.il>
# POSTMARK_SERVER_TOKEN=
# POSTMARK_FROM_EMAIL=

# --- Edge Function auto-maintenance (סודות בפרויקט Supabase, לא חובה ב־Next) ---
# APP_BASE_URL=https://app.yourbrand.co.il
# MAINTENANCE_CRON_SECRET=
# MAINTENANCE_SELF_HEAL=false

# ============================================================================
# Production-Readiness additions (Sprint 0 / Day 2 — 2026-05-10)
# ============================================================================

# --- Feature flags ---
# כשהערך הוא "true" — מציגים את ה-pitch UI (lobby, CEO command-center,
# כפתורי ה-PDF הדמו של חוזה/חשבון/PO) וכפתור "🚀 חמ"ל משקיעים" ב-header.
# ללקוח משלם בפרודקשן: השאירו ריק או "false". ברירת מחדל ב-`lib/feature-flags.ts`: false.
# NEXT_PUBLIC_DEMO_MODE=false

# --- Error monitoring (Sentry) — Sprint 0 / Day 2 ---
# DSN ציבורי שנדרש גם בלקוח וגם בשרת. צרו פרויקט ב-https://sentry.io,
# בחרו platform "Next.js", העתיקו את ה-DSN. כל הפרויקט ה-Next חולק DSN אחד.
# NEXT_PUBLIC_SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/789012
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=marker-ofek-erp
# רק ב-CI: token לאפלוד source maps; אסור להפוך לפומבי.
# SENTRY_AUTH_TOKEN=

# --- Domain / auth ---
# בסיס ה-URL (משמש ב-callback URLs של Supabase Auth ובמיילים).
# NEXT_PUBLIC_SITE_URL=https://app.yourbrand.co.il
# רשימה מופרדת בפסיקים של hostnames מאושרים לכניסה ל-marker-ofek.
# MARKER_OFEK_AUTH_HOSTS=app.yourbrand.co.il,localhost:3000

# --- Storage buckets ---
# שם ה-bucket ב-Supabase Storage למסמכי פרויקט (DMS).
# NEXT_PUBLIC_PROJECT_DOCUMENTS_BUCKET=project-dms

# --- Webhooks חיצוניים (התראות תפעוליות) ---
# WhatsApp Cloud API webhook להתראות ERP (חריגות, ESC, …).
# ERP_WHATSAPP_ALERT_WEBHOOK_URL=
# התראה ייעודית כשמשתמש דורס מחיר שורה ב-PO מעבר לסף.
# PRICE_OVERRIDE_ALERT_WEBHOOK_URL=

# --- שירותי דאטה ישראליים (gov.il open-data) ---
# מזהי משאב ב-data.gov.il לשליפת ח.פ ושמות חברות מרשם.
# ISRAEL_TAX_REGISTRY_RESOURCE_ID=
# ISRAEL_TAX_REGISTRY_FIELD_TAX_ID=

# ============================================================================
# IoT Webhook Ingest — HMAC shared secrets (M4, 2026-07)
# Generate each with: openssl rand -hex 32
# Must match the secret configured in each vendor's webhook dashboard.
# Server-side only — never prefix with NEXT_PUBLIC_
# ============================================================================

# IOT_WEBHOOK_SECRET_VERKADA=
# IOT_WEBHOOK_SECRET_SALTO=
# IOT_WEBHOOK_SECRET_BUTTERFLYMX=
# IOT_WEBHOOK_SECRET_CUSTOM=

# ============================================================================
# AI Worker — shared secrets (M4, 2026-07)
# AI_WORKER_BEARER and AI_WORKER_SECRET MUST match the values in ai-worker/.env
# Generate each with: openssl rand -hex 32
# ============================================================================

# URL of the Python AI Worker service (no trailing slash)
# Dev: http://localhost:8001   Prod: https://your-worker.run.app
# AI_WORKER_URL=http://localhost:8001

# Bearer token — Supabase pg_net trigger includes this in every request to the Worker
# AI_WORKER_BEARER=

# HMAC secret — Worker signs callback POSTs to /api/erp/ai/jobs/{id}/result with this
# AI_WORKER_SECRET=

# Sentinel UUID written as created_by on system-generated Work Orders (IoT correlator)
# Create a dedicated service-account user in Supabase Auth and paste its UUID here
# AI_WORKER_SYSTEM_USER_ID=

# --- אנשי קצה (admins / שותפים מנהלים) ---
# מייל מנהל אתר ראשי — מקבל התראות תפעוליות ברמת פרויקט.
# MARKER_OFEK_SITE_MANAGER_EMAIL=
# מייל שותף "סאמר" (managing partner scope) — להרחבה אוטומטית של גישה.
# PARTNER_SAMER_EMAIL=

# --- Dev/staging only (אל תפעילו בפרודקשן) ---
# הופך את כל המודולים ל-on (עוקף role-based gating). פתוח גם בלקוח.
# NEXT_PUBLIC_FORCE_ALL_MODULES_ON=false
# Origins נוספים שמותרים ל-Server Actions (ל-Cloudflare Tunnel וכד').
# DEV_SERVER_ACTIONS_EXTRA_ORIGINS=https://my-tunnel.example.com
