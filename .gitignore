# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but the root example template SHOULD be committed for new developer onboarding.
# Anchored to repo root only — never un-ignores files inside node_modules / .venv.
!/.env.example

# Python virtualenvs (ai-worker bundles its own .venv with thousands of files)
.venv/
**/.venv/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (local tools / accidental commits)
__pycache__/
*.py[cod]
*.pyc

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# local cloud credentials (never commit service account keys)
/.credentials/
/.credentials/*.json
/.credentials/google-cloud-key.json

# Windows / Drive sync metadata files
desktop.ini
**/desktop.ini

# transient local upload/cache artifacts (can contain generated CSS snapshots)
/.tmp.driveupload/
.env*.local
